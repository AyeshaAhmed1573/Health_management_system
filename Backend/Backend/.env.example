# MongoDB
MONGO_URL=mongodb://localhost:27017/health-management

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here_change_this
JWT_EXPIRES_IN=7d

# Admin Signup Secret
ADMIN_SIGNUP_SECRET=your_admin_signup_secret_here

# Frontend URL
FRONTEND_URL=http://localhost:5173

# AI chatbot
GEMINI_API_KEY=your_gemini_key

# Payments (mock | manual) - see Services/paymentService.js
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change_me

# Reminder scheduler
REMINDERS_ENABLED=true

# Email Configuration (for OTP/notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Server
PORT=5000

# Node Environment
NODE_ENV=development

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./public/uploads
